# Copy this file to .env and fill in your Neo4j details.
# Neo4j AuraDB Free: the URI looks like neo4j+s://xxxxxxxx.databases.neo4j.io
# Neo4j Desktop or Docker on your computer: neo4j://localhost:7687
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=supplychain
